# Same API the Telegram bot used
API_URL=http://localhost:3000
# Image server (keep the trailing slash)
IMAGE_SERVER_URL=http://localhost:3001/

# Login for this website - CHANGE BOTH
ADMIN_PASSWORD=change-me
# Any long random text (16+ characters), e.g. run: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Product field names in your backend
NAME_FA_FIELD=name_fa
DESCRIPTION_FA_FIELD=description_fa

# Leave empty. Only set it if your backend still REQUIRES a parent category id
PRODUCT_PARENT_ID=
